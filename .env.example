# Copy to .env in the repository root. Never commit the real file.

# Required for live analysis and chat. The app starts without it; those routes return 503.
GROQ_API_KEY=your_groq_api_key_here

# Groq model id. llama-3.3-70b-versatile is the default used by the graph.
# If Groq retires a model, set another id (for example gemma2-9b-it) and restart the API.
GROQ_MODEL=llama-3.3-70b-versatile

# Matches docker-compose.yml (host port 54329 -> container 5432).
DATABASE_URL=postgresql+psycopg://rca:rca@localhost:54329/rca

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:41731,http://127.0.0.1:41731
